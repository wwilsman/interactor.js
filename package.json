{
  "name": "interactor.js",
  "description": "Fast, intuitive, asynchronous interactions for anything that runs in a browser.",
  "version": "3.6.2",
  "license": "MIT",
  "repository": "https://github.com/wwilsman/interactor.js",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "browser": "bundle/interactor.js",
  "exports": {
    "types": "./types/index.d.ts",
    "module": "./lib/index.js",
    "default": "./bundle/interactor.js"
  },
  "files": [
    "bundle",
    "lib",
    "types"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "rollup --config",
    "build:types": "tsc --outDir types",
    "prepack": "npm run build",
    "test": "npm run lint && npm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --browser.headless=false",
    "test:only": "vitest run",
    "test:types": "tsc --project tests",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "rollup": "^4.68.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.7"
    }
  }
}
